# Server-only — where the Nitro server reaches PocketBase. The browser never
# talks to PocketBase directly (everything goes through the /pb proxy route),
# so this does NOT need the NUXT_PUBLIC_ prefix.
# Defaults to http://localhost:8090, matching docker/docker-compose.yml.
POCKETBASE_URL=http://localhost:8090

# Set to false to hide the sign-up form. The PocketBase hook enforces the same
# flag server-side (see docker/.env), so keep both values in sync.
ALLOW_REGISTRATION=true
