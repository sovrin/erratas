{
  "name": "erratas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "build:sdk": "esbuild packages/sdk/src/index.ts --bundle --format=esm --target=es2020 --minify --outfile=public/v1/errors.js --log-level=warning",
    "sdk:build": "pnpm --dir packages/sdk build",
    "typecheck": "tsc -p packages/sdk",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "debug": "pnpm sdk:build && node scripts/debug-server.mjs",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check .",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.42",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "happy-dom": "20.11.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
