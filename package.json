{
  "name": "erratas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "debug": "npm run sdk:build && node scripts/debug-server.mjs",
    "dev": "nuxt dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pb:backup": "bash scripts/pb-backup.sh",
    "pb:clear-hooks": "node --import tsx scripts/clear-pb-hooks.ts",
    "pb:down": "docker compose -f docker/docker-compose.yml down",
    "pb:install-hooks": "node --import tsx scripts/install-pb-hooks.ts",
    "pb:reset": "node --env-file=docker/.env --import tsx scripts/reset-pocketbase.ts",
    "pb:restore": "bash scripts/pb-restore.sh",
    "pb:superuser": "docker compose -f docker/docker-compose.yml exec database /pb/pocketbase --dir=/pb_data superuser upsert",
    "pb:up": "docker compose -f docker/docker-compose.yml up -d database",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "sdk:build": "npm run build --workspace @erratas/sdk",
    "sdk:typecheck": "npm run typecheck --workspace @erratas/sdk",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@nuxt/eslint": "^1.17.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.1",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "pocketbase": "^0.27.1",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "shadcn-nuxt": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
